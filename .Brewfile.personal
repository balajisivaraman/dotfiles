# Taps
tap "d12frosted/emacs-plus"
tap "tinted-theming/tinted"

# Core Development Tools
brew "git"
brew "vim"
brew "tmux"
brew "chezmoi"
cask "claude-code"

# Version Managers & Language Tools
brew "mise"
brew "uv"

# Container Tools
brew "colima"
brew "docker"
brew "docker-compose"

# Modern CLI Replacements
brew "bat"          # better cat
brew "eza"          # better ls
brew "fd"           # better find
brew "ripgrep"      # better grep
brew "fzf"          # fuzzy finder
brew "zoxide"       # smarter cd
brew "git-delta"    # better git diff
brew "tinted-theming/tinted/tinty" # tinted-theming theme manager

# Build Tools & Dependencies
brew "libfido2"
brew "openssh"
brew "cmake"        # needed by Emacs Vterm module
brew "libtool"      # needed by Emacs Vterm module
brew "pkgconf"      # needed by Jinx in Emacs

# Utilities
brew "jq"           # JSON processor
brew "ffmpeg"       # media processing
brew "yt-dlp"       # video downloader
brew "typst"        # document typesetting
brew "enchant"      # spell checking
brew "hugo"         # static blog generator

# Yubikey
brew "ykman"
cask "yubico-authenticator"

# Shell & Prompt
brew "fish"
brew "starship"

# Casks - Applications
cask "google-drive"
cask "emacs-plus-app"

# Casks - Fonts
cask "font-alegreya-sc"
cask "font-literata"
cask "font-noto-nerd-font"
