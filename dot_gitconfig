[alias]
    st = status
    ci = commit --verbose
    co = checkout
    di = diff
    dc = diff --cached
    amend = commit --amend
    aa = add --all
    ff = merge --ff-only
    pullff = pull --ff-only
    pullr = pull --rebase
    noff = merge --no-ff
    fa = fetch --all
    pom = push origin master
    b = branch
    ds = diff --stat=160,120
    dh1 = diff HEAD~1
    head = !git r -1
    h = !git head
    hp = "!. ~/.githelpers && show_git_head"
    r = !GIT_NO_PAGER=1 git l -30
    ra = !git r --all
    l = "!. ~/.githelpers && pretty_git_log"
    la = !git l --all
    ls-files-root = ! git ls-files

[merge]
    conflictstyle = zdiff3

[include]
    path = ~/.local/share/tinted-theming/tinty/tinted-delta-configs-file.gitconfig

[delta]
    navigate = true
    dark = true
    line-numbers = true
    hyperlinks = true
    tabs = 4
    file-style = "#ddc7a1"
    file-decoration-style = "#665c54"
    commit-decoration-style = "#665c54" bold box ul
    hunk-header-style = file line-number syntax
    hunk-header-file-style = bold
    hunk-header-decoration-style = "#665c54" box ul
    hunk-header-line-number-style = bold "#bdae93"
    line-numbers-left-style = "#665c54"
    line-numbers-right-style = "#665c54"
    line-numbers-zero-style = "#665c54"
    line-numbers-minus-style = bold "#ea6962"
    line-numbers-plus-style = bold "#a9b665"
    minus-style = syntax "#3c2828"
    minus-emph-style = bold syntax "#562b29"
    plus-style = syntax "#2d3828"
    plus-emph-style = bold syntax "#3a4a2b"
    blame-palette = "#1d2021 #282828 #32302f #3c3836 #504945"

[diff]
    colorMoved = default

[core]
    pager = delta

[commit]
    gpgsign = false

[credential]
    helper = cache --timeout=3600

[interactive]
    diffFilter = delta --color-only

[remote "origin"]
    prune = true

[remote "upstream"]
    prune = true

[pull]
    ff = only

[push]
    autoSetupRemote = true

[init]
    defaultBranch = main

